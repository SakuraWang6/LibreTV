# 复制为 .env.macos.local；该文件已被 Git 忽略。使用单引号包住密码与 JSON。
# .env.macos.local 由本机启动脚本 source，仅编辑你信任的内容。
PASSWORD='replace-with-a-private-password'

# 如 Node 不在标准 PATH 中，请取消注释并填写完整路径（路径可以有空格）。
# NODE_BINARY='/opt/homebrew/bin/node'

# 可选：你有权使用、兼容 LibreTV 的片源。不要将密码或私有片源提交到 Git。
DEFAULT_SOURCES='[]'
DEFAULT_RECOMMEND_SOURCE='hot-list'

# Mac 启动脚本默认启用磁盘影视库，存放在仓库的 .local/library/。
# 如需存放在其他磁盘，可设置一个固定的绝对目录；请保持磁盘可用。
# LOCAL_LIBRARY_DIR='/Volumes/Media/LibreTV'

# 后台下载由启动服务管理，关闭窗口仍会继续；需要 FFmpeg。
# FFMPEG_PATH='/opt/homebrew/bin/ffmpeg'
# BACKGROUND_DOWNLOAD_MAX_GB='20'

# 可选：从服务器按需保存离线副本、同步观看进度。密码仅保存在本机配置。
# LIBRARY_SERVER_URL='https://media.example.com'
# LIBRARY_SERVER_PASSWORD='your-private-server-password'
